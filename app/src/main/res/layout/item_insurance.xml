<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="8dp"
    android:background="@drawable/rounded_card_bg"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_insurance_company"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Insurance Company"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />

        <ImageView
            android:id="@+id/btn_update_insurance"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/button_green"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Update Insurance" />

        <ImageView
            android:id="@+id/btn_delete_insurance"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/color_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Insurance" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_insurance_vehicle_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vehicle: AB-12-CD-3456"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tv_insurance_policy_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Policy No: POL-123456"
        android:textSize="14sp"
        android:textColor="@color/text_light"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tv_insurance_expiry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Expiry: 2026-12-31"
            android:textSize="14sp"
            android:textColor="@color/text_light" />

        <TextView
            android:id="@+id/tv_insurance_premium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 5,000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/button_green" />
    </LinearLayout>
</LinearLayout>
